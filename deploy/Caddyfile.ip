http://192.144.235.126 {
    handle /.well-known/acme-challenge/* {
        root * /var/www/doubao-acme
        file_server
    }

    handle {
        redir https://192.144.235.126{uri} permanent
    }
}

:443 {
    tls /etc/caddy/certs/ip-fullchain.pem /etc/caddy/certs/ip-privkey.pem
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000
}
